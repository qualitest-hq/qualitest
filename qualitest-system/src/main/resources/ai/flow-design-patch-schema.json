{
  "type": "object",
  "description": "submit_flow_design_patch 的入参：画布增量（节点/边/场景）与中文流程说明。同一轮 patch 须为原子变更包：addEdge 的端点须已存在或在本轮 addNodes 中；condition 须同时提交 branches[].target 与出边；数组字段（rules/branches/extracts）须给完整数组。",
  "definitions": {
    "patchNode": {
      "type": "object",
      "description": "新增或更新的单个画布节点；http 须 callMode，subflow 须 subflowId",
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["http", "assert", "condition", "assign", "delay", "script", "subflow"]
        },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "data": { "type": "object" }
      },
      "required": ["type", "data"],
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "http" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": ["callMode"],
                "properties": {
                  "callMode": {
                    "type": "string",
                    "enum": ["project", "external"],
                    "description": "必填：project 绑定项目接口；external 调外联 URL（禁止填 testProjectApiId）"
                  },
                  "name": { "type": "string" },
                  "testProjectApiId": { "type": "string", "description": "仅 callMode=project" },
                  "externalUrl": { "type": "string", "description": "仅 callMode=external，支持 {{env.*}}" },
                  "httpMethod": { "type": "string", "description": "仅 callMode=external 必填" },
                  "headers": { "type": "array" },
                  "requestBody": {
                    "type": "string",
                    "description": "临时字段：project 模式写入 requestValueOverrides.bodyExample 后删除；external 为请求体"
                  },
                  "preScript": { "type": "string" },
                  "postScript": { "type": "string" },
                  "requestValueOverrides": {
                    "type": "object",
                    "description": "project 模式测值覆盖（仅与资产默认不同的项）；含 paramDefaults、bodyExample。不要写整份 requestConfig",
                    "properties": {
                      "paramDefaults": {
                        "type": "object",
                        "description": "按参数 name 覆盖 query/path/header 的 value"
                      },
                      "bodyExample": {
                        "description": "覆盖 JSON body 示例/测值"
                      }
                    }
                  },
                  "requestConfig": {
                    "type": "object",
                    "description": "仅 callMode=external 可保留；project 模式禁止写入，系统会剥离"
                  },
                  "apiPath": {
                    "type": "string",
                    "description": "project 模式勿写；路径跟所绑 API。路径变更须换绑 testProjectApiId"
                  },
                  "extracts": { "type": "array" },
                  "timeoutMs": { "type": "number" },
                  "useRunSession": { "type": "boolean" },
                  "summary": { "type": "string" }
                },
                "allOf": [
                  {
                    "if": { "properties": { "callMode": { "const": "external" } } },
                    "then": { "required": ["externalUrl", "httpMethod"] }
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "subflow" } } },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": ["subflowId"],
                "properties": {
                  "subflowId": { "type": "string", "description": "被引用的同项目测试流 id" },
                  "subflowName": { "type": "string", "description": "展示用名称，可省略" },
                  "versionPolicy": {
                    "type": "string",
                    "enum": ["pinned", "latest"],
                    "description": "pinned 使用 pinnedGraphJson 固化；latest 每次 Run 取子流当前图"
                  },
                  "pinnedGraphJson": { "type": "object", "description": "versionPolicy=pinned 时固化的子图 JSON" },
                  "inputs": {
                    "type": "array",
                    "description": "进入子流前写入子 flow 的种子 [{name, value}]",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "value": { "type": "string" }
                      }
                    }
                  },
                  "outputs": {
                    "type": "array",
                    "description": "子流结束后映射回父 flow [{name, flowKey}]",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "flowKey": { "type": "string" }
                      }
                    }
                  },
                  "name": { "type": "string" },
                  "summary": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "addNodes": {
      "type": "array",
      "description": "待新增节点列表",
      "items": { "$ref": "#/definitions/patchNode" }
    },
    "updateNodes": {
      "type": "array",
      "description": "待更新节点列表（通常只含 id 与 data 增量）",
      "items": { "$ref": "#/definitions/patchNode" }
    },
    "addEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label": { "type": "string" }
        },
        "required": ["source", "target"]
      }
    },
    "updateEdges": { "type": "array" },
    "suggestedDeletes": {
      "type": "object",
      "properties": {
        "nodeIds": { "type": "array", "items": { "type": "string" } },
        "edgeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenarioPatch": {
      "type": "object",
      "properties": {
        "activeScenarioId": { "type": "string", "description": "切换默认运行场景 id" },
        "addScenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "testProjectEnvId": { "type": "string" },
              "flowSeed": { "type": "object" },
              "remark": { "type": "string" }
            }
          }
        },
        "updateScenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "testProjectEnvId": { "type": "string" },
              "flowSeed": { "type": "object" },
              "remark": { "type": "string" }
            },
            "required": ["id"]
          }
        },
        "deleteScenarioIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": { "type": "string", "description": "中文流程说明" }
  }
}
