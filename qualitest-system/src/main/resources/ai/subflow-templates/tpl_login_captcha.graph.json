{
  "nodes": [
    {
      "id": "e_entry",
      "type": "subflow-entry",
      "name": "子流入口",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "doc": "验证码登录子流模板",
        "inputDecl": [
          {
            "name": "username",
            "type": "string",
            "required": true
          },
          {
            "name": "password",
            "type": "string",
            "required": true
          }
        ],
        "fallbackOut": {
          "code": "NO_RETURN",
          "message": "未执行到返回节点"
        }
      }
    },
    {
      "id": "captcha_image",
      "type": "http",
      "name": "获取验证码",
      "position": {
        "x": 200,
        "y": 0
      },
      "data": {
        "callMode": "project",
        "testProjectApiId": "",
        "httpMethod": "GET",
        "apiPath": "/api/captchaImage",
        "extracts": [
          {
            "from": "body",
            "expr": "$.img",
            "scope": "flow",
            "name": "captchaImageBase64"
          },
          {
            "from": "body",
            "expr": "$.uuid",
            "scope": "flow",
            "name": "captchaUuid"
          }
        ]
      }
    },
    {
      "id": "captcha_solve",
      "type": "http",
      "name": "外联打码",
      "position": {
        "x": 400,
        "y": 0
      },
      "data": {
        "callMode": "external",
        "httpMethod": "POST",
        "externalUrl": "{{env.captchaApiUrl}}",
        "requestConfig": {
          "method": "POST",
          "body": {
            "mode": "json",
            "json": {
              "example": "{\"image\":\"{{flow.captchaImageBase64}}\"}"
            }
          }
        },
        "extracts": [
          {
            "from": "body",
            "expr": "$.code",
            "scope": "flow",
            "name": "captchaCode"
          }
        ]
      }
    },
    {
      "id": "login_http",
      "type": "http",
      "name": "验证码登录",
      "position": {
        "x": 600,
        "y": 0
      },
      "data": {
        "callMode": "project",
        "testProjectApiId": "",
        "httpMethod": "POST",
        "apiPath": "/api/login",
        "requestConfig": {
          "method": "POST",
          "body": {
            "mode": "json",
            "json": {
              "example": "{\"username\":\"{{in.username}}\",\"password\":\"{{in.password}}\",\"code\":\"{{flow.captchaCode}}\",\"uuid\":\"{{flow.captchaUuid}}\"}"
            }
          }
        },
        "extracts": [
          {
            "from": "body",
            "expr": "$.data.token",
            "scope": "flow",
            "name": "token"
          }
        ]
      }
    },
    {
      "id": "pack_out",
      "type": "assign",
      "name": "组出参",
      "position": {
        "x": 800,
        "y": 0
      },
      "data": {
        "assignments": [
          {
            "scope": "flow",
            "name": "out",
            "op": "set",
            "value": {
              "body": {
                "token": "{{flow.token}}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "n_ret",
      "type": "subflow-return",
      "name": "返回父流",
      "position": {
        "x": 1000,
        "y": 0
      },
      "data": {
        "from": "flow.out"
      }
    }
  ],
  "edges": [
    {
      "id": "ed_entry_captcha",
      "source": "e_entry",
      "target": "captcha_image"
    },
    {
      "id": "ed_captcha_solve",
      "source": "captcha_image",
      "target": "captcha_solve"
    },
    {
      "id": "ed_solve_login",
      "source": "captcha_solve",
      "target": "login_http"
    },
    {
      "id": "ed_login_pack",
      "source": "login_http",
      "target": "pack_out"
    },
    {
      "id": "ed_pack_ret",
      "source": "pack_out",
      "target": "n_ret"
    }
  ],
  "meta": {
    "schemaVersion": 2,
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    }
  }
}