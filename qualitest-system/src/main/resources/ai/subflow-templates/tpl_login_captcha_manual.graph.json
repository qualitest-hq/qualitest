{
  "nodes": [
    {
      "id": "e_entry",
      "type": "subflow-entry",
      "name": "子流入口",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "doc": "手动填验证码登录子流模板",
        "inputShape": {
          "body": [
            {
              "name": "username",
              "type": "string",
              "required": true
            },
            {
              "name": "password",
              "type": "string",
              "required": true
            }
          ],
          "query": [],
          "headers": []
        },
        "fallbackOut": {
          "status": 500,
          "headers": {
            "Content-Type": "application/json;charset=UTF-8"
          },
          "body": {
            "code": "NO_RETURN",
            "message": "未执行到返回节点"
          }
        }
      }
    },
    {
      "id": "captcha_image",
      "type": "http",
      "name": "获取验证码",
      "position": {
        "x": 200,
        "y": 0
      },
      "data": {
        "callMode": "project",
        "testProjectApiId": "",
        "httpMethod": "GET",
        "apiPath": "/api/captchaImage",
        "extracts": [
          {
            "from": "body",
            "expr": "$.img",
            "scope": "flow",
            "name": "captchaImageBase64"
          },
          {
            "from": "body",
            "expr": "$.uuid",
            "scope": "flow",
            "name": "captchaUuid"
          }
        ]
      }
    },
    {
      "id": "captcha_input",
      "type": "input",
      "name": "填写验证码",
      "position": {
        "x": 400,
        "y": 0
      },
      "data": {
        "prompt": "请查看上一步验证码图片后填写",
        "fields": [
          {
            "name": "captchaCode",
            "label": "验证码",
            "type": "text",
            "required": true,
            "placeholder": "",
            "defaultValue": "",
            "options": []
          }
        ]
      }
    },
    {
      "id": "login_http",
      "type": "http",
      "name": "验证码登录",
      "position": {
        "x": 600,
        "y": 0
      },
      "data": {
        "callMode": "project",
        "testProjectApiId": "",
        "httpMethod": "POST",
        "apiPath": "/api/login",
        "requestConfig": {
          "method": "POST",
          "body": {
            "mode": "json",
            "json": {
              "example": "{\"username\":\"{{in.username}}\",\"password\":\"{{in.password}}\",\"code\":\"{{flow.captchaCode}}\",\"uuid\":\"{{flow.captchaUuid}}\"}"
            }
          }
        },
        "extracts": [
          {
            "from": "body",
            "expr": "$.data.token",
            "scope": "flow",
            "name": "token"
          }
        ]
      }
    },
    {
      "id": "pack_out",
      "type": "assign",
      "name": "组出参",
      "position": {
        "x": 800,
        "y": 0
      },
      "data": {
        "assignments": [
          {
            "scope": "flow",
            "name": "out",
            "op": "set",
            "value": {
              "body": {
                "token": "{{flow.token}}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "n_ret",
      "type": "subflow-return",
      "name": "返回父流",
      "position": {
        "x": 1000,
        "y": 0
      },
      "data": {
        "from": "flow.out"
      }
    }
  ],
  "edges": [
    {
      "id": "ed_entry_captcha",
      "source": "e_entry",
      "target": "captcha_image"
    },
    {
      "id": "ed_captcha_input",
      "source": "captcha_image",
      "target": "captcha_input"
    },
    {
      "id": "ed_input_login",
      "source": "captcha_input",
      "target": "login_http"
    },
    {
      "id": "ed_login_pack",
      "source": "login_http",
      "target": "pack_out"
    },
    {
      "id": "ed_pack_ret",
      "source": "pack_out",
      "target": "n_ret"
    }
  ],
  "meta": {
    "schemaVersion": 2,
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    },
    "startNodeId": "e_entry"
  }
}