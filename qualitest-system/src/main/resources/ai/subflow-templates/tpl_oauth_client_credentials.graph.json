{
  "nodes": [
    {
      "id": "e_entry",
      "type": "subflow-entry",
      "name": "子流入口",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "doc": "OAuth Client Credentials 子流模板",
        "inputDecl": [],
        "fallbackOut": {
          "code": "NO_RETURN",
          "message": "未执行到返回节点"
        }
      }
    },
    {
      "id": "oauth_token",
      "type": "http",
      "name": "OAuth Client Credentials",
      "position": {
        "x": 200,
        "y": 0
      },
      "data": {
        "callMode": "external",
        "httpMethod": "POST",
        "externalUrl": "{{env.oauthTokenUrl}}",
        "headers": [
          {
            "_enabled": true,
            "name": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "requestConfig": {
          "method": "POST",
          "body": {
            "mode": "urlencoded",
            "urlencoded": [
              {
                "_enabled": true,
                "name": "grant_type",
                "value": "client_credentials"
              },
              {
                "_enabled": true,
                "name": "client_id",
                "value": "{{asset.oauth.clientId}}"
              },
              {
                "_enabled": true,
                "name": "client_secret",
                "value": "{{asset.oauth.clientSecret}}"
              }
            ]
          }
        },
        "extracts": [
          {
            "from": "body",
            "expr": "$.access_token",
            "scope": "flow",
            "name": "token"
          },
          {
            "from": "body",
            "expr": "$.expires_in",
            "scope": "flow",
            "name": "tokenExpiresIn"
          }
        ]
      }
    },
    {
      "id": "pack_out",
      "type": "assign",
      "name": "组出参",
      "position": {
        "x": 400,
        "y": 0
      },
      "data": {
        "assignments": [
          {
            "scope": "flow",
            "name": "out",
            "op": "set",
            "value": {
              "body": {
                "token": "{{flow.token}}",
                "tokenExpiresIn": "{{flow.tokenExpiresIn}}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "n_ret",
      "type": "subflow-return",
      "name": "返回父流",
      "position": {
        "x": 600,
        "y": 0
      },
      "data": {
        "from": "flow.out"
      }
    }
  ],
  "edges": [
    {
      "id": "ed_entry_oauth",
      "source": "e_entry",
      "target": "oauth_token"
    },
    {
      "id": "e_oauth_pack",
      "source": "oauth_token",
      "target": "pack_out"
    },
    {
      "id": "e_pack_ret",
      "source": "pack_out",
      "target": "n_ret"
    }
  ],
  "meta": {
    "schemaVersion": 2,
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    }
  }
}