{
  "nodes": [
    {
      "id": "e_entry",
      "type": "subflow-entry",
      "name": "子流入口",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "doc": "双身份登录子流模板",
        "inputDecl": [
          {
            "name": "userA",
            "type": "string",
            "required": true
          },
          {
            "name": "passA",
            "type": "string",
            "required": true
          },
          {
            "name": "userB",
            "type": "string",
            "required": true
          },
          {
            "name": "passB",
            "type": "string",
            "required": true
          }
        ],
        "fallbackOut": {
          "code": "NO_RETURN",
          "message": "未执行到返回节点"
        }
      }
    },
    {
      "id": "login_a",
      "type": "http",
      "name": "身份 A 登录",
      "position": {
        "x": 200,
        "y": 0
      },
      "data": {
        "callMode": "project",
        "testProjectApiId": "",
        "httpMethod": "POST",
        "apiPath": "/api/login",
        "requestConfig": {
          "method": "POST",
          "body": {
            "mode": "json",
            "json": {
              "example": "{\"username\":\"{{in.userA}}\",\"password\":\"{{in.passA}}\"}"
            }
          }
        },
        "extracts": [
          {
            "from": "body",
            "expr": "$.data.token",
            "scope": "flow",
            "name": "tokenA"
          }
        ]
      }
    },
    {
      "id": "login_b",
      "type": "http",
      "name": "身份 B 登录",
      "position": {
        "x": 400,
        "y": 0
      },
      "data": {
        "callMode": "project",
        "testProjectApiId": "",
        "httpMethod": "POST",
        "apiPath": "/api/login",
        "requestConfig": {
          "method": "POST",
          "body": {
            "mode": "json",
            "json": {
              "example": "{\"username\":\"{{in.userB}}\",\"password\":\"{{in.passB}}\"}"
            }
          }
        },
        "extracts": [
          {
            "from": "body",
            "expr": "$.data.token",
            "scope": "flow",
            "name": "tokenB"
          }
        ]
      }
    },
    {
      "id": "pack_out",
      "type": "assign",
      "name": "组出参",
      "position": {
        "x": 600,
        "y": 0
      },
      "data": {
        "assignments": [
          {
            "scope": "flow",
            "name": "out",
            "op": "set",
            "value": {
              "body": {
                "tokenA": "{{flow.tokenA}}",
                "tokenB": "{{flow.tokenB}}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "n_ret",
      "type": "subflow-return",
      "name": "返回父流",
      "position": {
        "x": 800,
        "y": 0
      },
      "data": {
        "from": "flow.out"
      }
    }
  ],
  "edges": [
    {
      "id": "ed_entry_login_a",
      "source": "e_entry",
      "target": "login_a"
    },
    {
      "id": "e_a_b",
      "source": "login_a",
      "target": "login_b"
    },
    {
      "id": "e_b_pack",
      "source": "login_b",
      "target": "pack_out"
    },
    {
      "id": "e_pack_ret",
      "source": "pack_out",
      "target": "n_ret"
    }
  ],
  "meta": {
    "schemaVersion": 2,
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    }
  }
}