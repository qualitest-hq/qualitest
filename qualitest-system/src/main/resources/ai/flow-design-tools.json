        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_flow_api_health",
      "description": "检查当前画布「项目接口」HTTP 节点的 API 语义健康告警（API_MISSING / ORPHAN_PARAM / EXTRACT_PATH_MISSING）。用户提到左上角「API 语义」告警、绑定失效、接口不存在或已删除、修复测试流异常（非 Run 失败）时优先调用；返回 nodeId、绑定 apiId、message，以及节点残留 apiName/apiPath 便于换绑",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填或由信封提供"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_subflow_templates",
      "description": "列举平台内置子流模板（tpl_*）与项目测试流摘要，供 subflow 节点选型；Web 改图场景优先使用",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "按测试流名称模糊过滤 projectSubflows；可省略"
          },
          "limit": {
            "type": "integer",
            "description": "projectSubflows 返回条数上限，默认 20"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_subflow_detail",
      "description": "读取测试流拓扑摘要与 flowOutputs，无需 graphJson 信封；浏览子流结构优先于 get_flow",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "被引用的测试流 id；可省略，将使用请求上下文中的 testFlowId"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_http_node",
      "description": "新增或修改单个HTTP节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "data": {
            "type": "object",
            "required": [
              "callMode"
            ],
            "properties": {
              "callMode": {
                "type": "string",
                "enum": [
                  "project",
                  "external"
                ]
              },
              "name": {
                "type": "string"
              },
              "testProjectApiId": {
                "type": "string"
              },
              "externalUrl": {
                "type": "string"
              },
              "httpMethod": {
                "type": "string"
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "requestBody": {
                "type": "string"
              },
              "requestValueOverrides": {
                "type": "object",
                "description": "节点测值覆盖（两桶）。query/path/header/表单用 paramDefaults；JSON body 用 bodyExample。值可为字面量或 {{flow.*}}。参数名只在 paramDefaults/bodyExample 内。",
                "properties": {
                  "paramDefaults": {
                    "type": "object",
                    "description": "按参数名覆盖 query/path/header/form-data/urlencoded 的 value"
                  },
                  "bodyExample": {
                    "description": "覆盖 JSON body 测值（对象或可解析 JSON 字符串）"
                  }
                }
              },
              "extracts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "expr"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "写入变量名，如 token"
                    },
                    "expr": {
                      "type": "string",
                      "description": "from=body 时须 $ 开头 JsonPath；from=setCookie 时为 Cookie 名"
                    },
                    "from": {
                      "type": "string",
                      "enum": [
                        "body",
                        "header",
                        "setCookie"
                      ]
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "flow",
                        "asset"
                      ]
                    }
                  }
                }
              },
              "statusCheck": {
                "type": "object",
                "description": "HTTP 状态码门禁。默认 2xx；探活常用 mode=whitelist、values=[200,401]；off 不校验状态码。",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "2xx",
                      "whitelist",
                      "off"
                    ],
                    "description": "2xx 仅 2xx 通过；whitelist 仅 values 内通过；off 不校验"
                  },
                  "values": {
                    "type": "array",
                    "description": "mode=whitelist 时的允许状态码",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              },
              "successCheck": {
                "type": "object",
                "description": "业务码校验。mode=inherit|off；可选 successValues 非空整数数组（如 [1]）覆盖项目/接口约定。",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "inherit",
                      "off"
                    ],
                    "description": "inherit 校验业务码；off 关闭"
                  },
                  "successValues": {
                    "type": "array",
                    "description": "可选；非空时优先于项目约定与接口 biz_code_config",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              },
              "timeoutMs": {
                "type": "number"
              },
              "preScript": {
                "type": "string",
                "description": "仅 callMode=external 生效（project 用接口库 preRequestScript）。宿主 api（服务端 GraalJS，无浏览器 btoa/atob、无 pm）：variables|environment|globals 的 get/set/unset/has；request.url|method 可赋；request.headers.add/remove/get/list；request.body 须整对象重赋（嵌套改字段不回写）；base64Encode/Decode、jsonParse/jsonStringify、hmacSha256、md5、sendRequest。改 query 改 url。例：api.request.body={kind:'json',raw:api.jsonStringify({password:api.base64Encode(api.environment.get('pwd'))})}。"
              },
              "postScript": {
                "type": "string",
                "description": "仅 callMode=external 生效（project 用接口库 postRequestScript）。宿主 api（服务端 GraalJS）：variables|environment|globals；可读 api.response.code|statusText|headers|json()|text()；可用 api.test/expect 断言；工具函数含 base64Encode/Decode、jsonParse/jsonStringify、hmacSha256、md5、sendRequest。request 在后置只读。"
              },
              "extractsOnFailure": {
                "type": "string",
                "enum": ["skip", "write"],
                "description": "步骤失败时是否仍执行 extracts。默认 skip（不写 asset/flow）；write 时失败也写入内存抽取（asset 落盘仍仅步骤最终通过时）。"
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "data"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_assert_node",
      "description": "新增或修改单个断言节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "data": {
            "type": "object",
            "required": [
              "rules"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "left",
                    "operator"
                  ],
                  "properties": {
                    "left": {
                      "type": "string",
                      "description": "断言左值，如 http.body.code / flow.orderId / http.status"
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "contains",
                        "not_contains",
