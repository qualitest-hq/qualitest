[
  {
    "type": "function",
    "function": {
      "name": "search_apis",
      "description": "按关键词搜索当前测试项目下的 API 接口，返回 id、method、path、name、精简 auth（mode/authProfileId）；keyword 可省略，将列举 scopeApiIds 或项目接口",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "搜索关键词，匹配接口名、路径或描述；可省略"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限，默认使用系统配置，最大不超过配置上限"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_api_details",
      "description": "批量获取 API 造流摘要（单条也用本工具）。每条含 path/query/header/body 参数摘要、body 示例、响应 schema 摘要、designHints、responseConvention、suggestedExtracts（登录口会前置按端 loginHint）、鉴权 auth/headerHint。一次传入本流关键 testProjectApiId（去重后最多 5 条）；不够再调第二次。超字节会从尾部暂缓部分 id（deferredIds），不会整包清空",
      "parameters": {
        "type": "object",
        "properties": {
          "testProjectApiIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "项目 API ID 列表；单条也请传长度为 1 的数组；去重后最多 5 条"
          }
        },
        "required": [
          "testProjectApiIds"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "append_api_design_hints",
      "description": "向接口 design_hints 追加造流设计提示并直接落库（人机均可维护；导入不覆盖）。确认业务约定（如 body 字段二选一、金额符号）后调用；勿写入 apiDescription。每条尽量短（≤200 字）。",
      "parameters": {
        "type": "object",
        "properties": {
          "testProjectApiId": {
            "type": "string",
            "description": "项目 API ID"
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "待追加的短提示列表"
          }
        },
        "required": [
          "testProjectApiId",
          "hints"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_graph_summary",
      "description": "获取测试流画布的节点与边摘要。单节点用 get_node_detail，单边用 get_edge_detail。Web 使用当前画布；MCP 可仅传 testFlowId",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填或由信封提供"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_flow_meta",
      "description": "获取画布 meta：运行场景列表摘要、flowOutputNames、startNodeId。单场景详情用 get_scenario_detail。MCP 可仅传 testFlowId",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填或由信封提供"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_project_envs",
      "description": "列举当前测试项目的环境 id、名称、URL 与环境变量键名（不含值）；为场景绑定 testProjectEnvId 或编写 {{env.*}} 占位符前建议调用",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_asset_variables",
      "description": "列举项目素材库（参数资产）变量：key、备注、子字段名；不含明文值。编写或选用 {{asset.key.field}} 前必须先调用；若列表无对应 key，先 upsert_asset_variables 再引用（半自动待聊天侧确认；全自动工具内直写），禁止臆造 asset 键",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "upsert_asset_variables",
      "description": "按 key 新增或更新项目素材库条目。半自动：提案 pending，用户聊天侧确认后落盘；全自动：工具内直接写库，status=confirmed。fields 为扁平字段对象；返回 key/字段名/action/status，不含明文。登录口令等优先如 clientAuth（mobile/password）。仅 Web；勿在助手正文复述明文",
      "parameters": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "素材键名，如 clientAuth"
          },
          "remark": {
            "type": "string",
            "description": "可选备注"
          },
          "fields": {
            "type": "object",
            "description": "字段名到值的映射，如 {\"mobile\":\"13800000001\",\"password\":\"...\"}",
            "additionalProperties": true
          }
        },
        "required": [
          "key",
          "fields"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_node_detail",
      "description": "获取单个节点的 type 与完整 data。MCP 可仅传 testFlowId 自动加载画布",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "节点 id"
          },
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填或由信封提供"
          }
        },
        "required": [
          "nodeId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_edge_detail",
      "description": "获取单条边完整字段（id/source/target/label）。改边或删边前优先调用；MCP 可仅传 testFlowId",
      "parameters": {
        "type": "object",
        "properties": {
          "edgeId": {
            "type": "string",
            "description": "边 id"
          },
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填或由信封提供"
          }
        },
        "required": [
          "edgeId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_scenario_detail",
      "description": "获取单个运行场景配置（含 flowSeed 键名，不含明文）。改场景前优先调用；MCP 可仅传 testFlowId",
      "parameters": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "description": "场景 id"
          },
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填或由信封提供"
          }
        },
        "required": [
          "scenarioId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_run_failure",
      "description": "获取某次测试流 Run 的失败步骤现场。按 failureCategory 分区：bizCode（业务码）、assert（断言）、other；同时返回 bizCodeFailures / assertFailures / otherFailures 列表",
      "parameters": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "description": "测试流运行记录 id；可省略，将使用请求上下文中的 contextRunId"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_flow_api_health",
      "description": "检查当前画布「项目接口」HTTP 节点的 API 语义健康告警（API_MISSING / ORPHAN_PARAM / EXTRACT_PATH_MISSING）。用户提到左上角「API 语义」告警、绑定失效、接口不存在或已删除、修复测试流异常（非 Run 失败）时优先调用；返回 nodeId、绑定 apiId、message，以及节点残留 apiName/apiPath 便于换绑",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填或由信封提供"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_subflow_templates",
      "description": "列举平台内置子流模板（tpl_*）与项目测试流摘要，供 subflow 节点选型；Web 改图场景优先使用",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "按测试流名称模糊过滤 projectSubflows；可省略"
          },
          "limit": {
            "type": "integer",
            "description": "projectSubflows 返回条数上限，默认 20"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_subflow_detail",
      "description": "读取测试流拓扑摘要与 flowOutputs，无需 graphJson 信封；浏览子流结构优先于 get_flow",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "被引用的测试流 id；可省略，将使用请求上下文中的 testFlowId"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_http_node",
      "description": "新增或修改单个HTTP节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "data": {
            "type": "object",
            "required": [
              "callMode"
            ],
            "properties": {
              "callMode": {
                "type": "string",
                "enum": [
                  "project",
                  "external"
                ]
              },
              "name": {
                "type": "string"
              },
              "testProjectApiId": {
                "type": "string"
              },
              "externalUrl": {
                "type": "string"
              },
              "httpMethod": {
                "type": "string"
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "requestBody": {
                "type": "string"
              },
              "requestValueOverrides": {
                "type": "object"
              },
              "extracts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "expr"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "写入变量名，如 token"
                    },
                    "expr": {
                      "type": "string",
                      "description": "from=body 时须 $ 开头 JsonPath；from=setCookie 时为 Cookie 名"
                    },
                    "from": {
                      "type": "string",
                      "enum": [
                        "body",
                        "header",
                        "setCookie"
                      ]
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "flow",
                        "asset"
                      ]
                    }
                  }
                }
              },
              "successCheck": {
                "type": "object"
              },
              "timeoutMs": {
                "type": "number"
              },
              "preScript": {
                "type": "string"
              },
              "postScript": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "data"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_assert_node",
      "description": "新增或修改单个断言节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "data": {
            "type": "object",
            "required": [
              "rules"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "left",
                    "operator"
                  ],
                  "properties": {
                    "left": {
                      "type": "string",
                      "description": "断言左值，如 http.body.code / flow.token / http.status"
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "contains",
                        "not_contains",
                        "exists"
                      ]
                    },
                    "right": {
                      "description": "比较右值；operator=exists 时可省略"
                    }
                  }
                },
                "minItems": 1
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "data"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_condition_node",
      "description": "新增或修改单个条件分支节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "data": {
            "type": "object",
            "required": [
              "branches"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "if",
                        "elif",
                        "else"
                      ]
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "left",
                          "operator"
                        ],
                        "properties": {
                          "left": {
                            "type": "string",
                            "description": "断言左值，如 http.body.code / flow.token / http.status"
                          },
                          "operator": {
                            "type": "string",
                            "enum": [
                              "eq",
                              "ne",
                              "gt",
                              "gte",
                              "lt",
                              "lte",
                              "contains",
                              "not_contains",
                              "exists"
                            ]
                          },
                          "right": {
                            "description": "比较右值；operator=exists 时可省略"
                          }
                        }
                      }
                    },
                    "terminal": {
                      "type": "boolean"
                    }
                  }
                },
                "minItems": 1
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "data"
        ]
      }
    }
  },
