[
  {
    "type": "function",
    "function": {
      "name": "list_flows",
      "description": "MCP 专用：按 keyword/limit 列举项目测试流摘要（不含 graphJson）。子流选型含平台模板请用 list_subflow_templates",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "按测试流名称模糊搜索；可省略"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限，默认 20"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_flow",
      "description": "MCP 专用：读取单条测试流完整 graphJson。浏览拓扑优先 get_subflow_detail 或带 testFlowId 的 get_graph_summary",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；可省略，将使用请求上下文中的 testFlowId"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_mcp_guide_version",
      "description": "MCP 专用：返回当前造流规程 guideVersion（CORE/SURVEY/FIX_RUN 内容指纹）。用于判断业务仓 .cursor/skills/qualitest/SKILL.md 是否过期；未过期则勿再 prompts/get 规程正文。无需参数。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_flow",
      "description": "MCP 专用：在当前项目新建一条空画布测试流并立即写库。返回 testFlowId，供后续 submit_* / run_test_flow 使用。须项目已开启「允许 MCP 全自动写流」",
      "parameters": {
        "type": "object",
        "properties": {
          "flowName": {
            "type": "string",
            "description": "测试流名称"
          },
          "flowDescription": {
            "type": "string",
            "description": "测试流说明；可省略"
          }
        },
        "required": ["flowName"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "import_apis",
      "description": "将结构化接口 items[] 按 HTTP 方法 + 规范化 path 写入当前测试项目接口库：已存在则更新，不存在则新增，成功即落库。须项目已开启「允许 MCP 导入接口」。建议分批、单次少批量。不会改写接口上的设计提示。更新时未传分组/注释则保留库内原值；新增未传分组则落入默认分组。",
      "parameters": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "description": "待导入的接口列表",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "description": "HTTP 方法，如 GET、POST"
                },
                "path": {
                  "type": "string",
                  "description": "接口路径；入库前会规范化（补前导斜杠、去掉尾部斜杠）"
                },
                "name": {
                  "type": "string",
                  "description": "接口显示名称"
                },
                "apiGroup": {
                  "type": "string",
                  "description": "接口分组，可用点号表示多级；省略时：更新保留库内分组，新增使用默认分组"
                },
                "description": {
                  "type": "string",
                  "description": "接口说明文字；省略时：更新保留库内说明，新增为空"
                },
                "pathParams": {
                  "type": "array",
                  "description": "路径参数列表（name / type / description 等）",
                  "items": { "type": "object" }
                },
                "queryParams": {
                  "type": "array",
                  "description": "查询参数列表",
                  "items": { "type": "object" }
                },
                "headerParams": {
                  "type": "array",
                  "description": "请求头参数列表；入库写入请求配置的声明头",
                  "items": { "type": "object" }
                },
                "bodyParams": {
                  "type": "array",
                  "description": "请求体字段列表，用于生成极简 JSON schema",
                  "items": { "type": "object" }
                },
                "bodyExample": {
                  "description": "请求体示例，对象或 JSON 字符串均可"
                },
                "responseSchemaSummary": {
                  "description": "响应 schema 摘要（对象）；可省略"
                },
                "authSuggestion": {
                  "type": "object",
                  "description": "鉴权建议。mode：none / inherit / override；可选 authProfileId、header（name + valueTemplate）",
                  "properties": {
                    "mode": { "type": "string" },
                    "authProfileId": { "type": "string" },
                    "header": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "valueTemplate": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "required": ["method", "path", "name"]
            }
          }
        },
        "required": ["items"]
      }
    }
  }
]
