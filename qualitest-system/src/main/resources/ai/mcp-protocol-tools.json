[
  {
    "type": "function",
    "function": {
      "name": "search_apis",
      "description": "按关键词搜索当前测试项目下的 API 接口，返回 id、method、path、name、精简 auth（mode/authProfileId）；keyword 可省略，将列举 scopeApiIds 或项目接口",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "搜索关键词，匹配接口名、路径或描述；可省略"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限，默认使用系统配置，最大不超过配置上限"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_api_details",
      "description": "批量获取 API 造流摘要（单条也用本工具）。每条含 path/query/header/body 参数摘要、body 示例、响应 schema 摘要、designHints、responseConvention、suggestedExtracts（登录口会按 Profile 托管头占位符前置抽取建议）、鉴权 auth/headerHint。一次传入本流关键 testProjectApiId（去重后最多 5 条）；不够再调第二次。超字节会从尾部暂缓部分 id（deferredIds），不会整包清空",
      "parameters": {
        "type": "object",
        "properties": {
          "testProjectApiIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "项目 API ID 列表；单条也请传长度为 1 的数组；去重后最多 5 条"
          }
        },
        "required": [
          "testProjectApiIds"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "append_api_design_hints",
      "description": "向接口 design_hints 追加造流设计提示并直接落库（人机均可维护；导入不覆盖）。确认业务约定（如 body 字段二选一、金额符号）后调用；勿写入 apiDescription。每条尽量短（≤200 字）。 【MCP 全自动】工具内直接写库。",
      "parameters": {
        "type": "object",
        "properties": {
          "testProjectApiId": {
            "type": "string",
            "description": "项目 API ID"
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "待追加的短提示列表"
          }
        },
        "required": [
          "testProjectApiId",
          "hints"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_graph_summary",
      "description": "获取测试流画布的节点与边摘要；另含 mermaid（flowchart TB 正文，便于预览拓扑）。单节点用 get_node_detail，单边用 get_edge_detail。MCP：传 testFlowId 加载画布（请求里带 testFlowId 即可）",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填（请求已带则可省略）"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_flow_meta",
      "description": "获取画布 meta：运行场景列表摘要、flowOutputNames、startNodeId。单场景详情用 get_scenario_detail。传 testFlowId（请求已带则可省略）",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填（请求已带则可省略）"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_project_envs",
      "description": "列举当前测试项目的环境 id、名称、URL 与环境变量键名（不含值）；为场景绑定 testProjectEnvId 或编写 {{env.*}} 占位符前建议调用",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_asset_variables",
      "description": "列举项目素材库（参数资产）变量：key、备注、子字段名；不含明文值。编写或选用 {{asset.key.field}} 前必须先调用；若列表无对应 key，先 upsert_asset_variables 再引用（半自动待聊天侧确认；全自动工具内直写），禁止臆造 asset 键",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "upsert_asset_variables",
      "description": "按 key 新增或更新项目素材库条目。半自动：提案 pending，用户聊天侧确认后落盘；全自动：工具内直接写库，status=confirmed。fields 为扁平字段对象；返回 key/字段名/action/status，不含明文。登录口令等优先如 clientAuth（mobile/password）。仅 Web；勿在助手正文复述明文 【MCP 全自动】工具内直接写库。",
      "parameters": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "素材键名，如 clientAuth"
          },
          "remark": {
            "type": "string",
            "description": "可选备注"
          },
          "fields": {
            "type": "object",
            "description": "字段名到值的映射，如 {\"mobile\":\"13800000001\",\"password\":\"...\"}",
            "additionalProperties": true
          }
        },
        "required": [
          "key",
          "fields"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_project_auth_profiles",
      "description": "列举多端配置 Profile：id、名称、pathPrefix、headerName、headerValueTemplate、responseConvention（四字段）、credentialTarget、credentialApi。造登录链、修 AUTH_TOKEN_MISSING、改托管头/响应约定前必须先调用；勿默认若依。不含密钥明文",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "upsert_auth_profile",
      "description": "浅合并更新多端 Profile（pathPrefix/headerName/headerValueTemplate/responseConvention/credentialApi/name）。半自动：提案 pending，聊天侧确认后落盘；全自动：工具内直写。更新须 profileId；新建须 create=true 且 patch 含 headerName 与 headerValueTemplate。改响应约定时 patch.responseConvention 可只传变更字段（如 successValues）。两端禁止同一凭证键。仅 Web 【MCP 全自动】工具内直接写库。",
      "parameters": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "description": "已有 Profile id；更新必填"
          },
          "create": {
            "type": "boolean",
            "description": "true 时新建 Profile（无 profileId 亦可）"
          },
          "patch": {
            "type": "object",
            "description": "浅合并字段：name、pathPrefix（字符串数组）、headerName、headerValueTemplate、responseConvention{codePath,successValues,messagePath,dataPath}、credentialApi{method,path}",
            "additionalProperties": true
          }
        },
        "required": [
          "patch"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_node_detail",
      "description": "获取单个节点的 type 与完整 data。传 testFlowId（请求已带则可省略）自动加载画布",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "节点 id"
          },
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填（请求已带则可省略）"
          }
        },
        "required": [
          "nodeId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_edge_detail",
