      "parameters": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "description": "场景 id"
          },
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填（请求已带则可省略）"
          }
        },
        "required": [
          "scenarioId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_run_failure",
      "description": "获取某次测试流 Run 的失败步骤现场。按 failureCategory 分区：bizCode/assert/other。须显式传 runId。",
      "parameters": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "description": "测试流运行记录 id；必填"
          }
        },
        "required": [
          "runId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_flow_api_health",
      "description": "检查当前画布「项目接口」HTTP 节点的 API 语义健康告警（API_MISSING / ORPHAN_PARAM / EXTRACT_PATH_MISSING）。用户提到左上角「API 语义」告警、绑定失效、接口不存在或已删除、修复测试流异常（非 Run 失败）时优先调用；返回 nodeId、绑定 apiId、message，以及节点残留 apiName/apiPath 便于换绑",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "测试流 id；MCP 未传 graphJson 时必填（请求已带则可省略）"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_subflow_templates",
      "description": "列举平台内置子流模板（tpl_*）与项目测试流摘要，供 subflow 节点选型；Web 改图场景优先使用",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "按测试流名称模糊过滤 projectSubflows；可省略"
          },
          "limit": {
            "type": "integer",
            "description": "projectSubflows 返回条数上限，默认 20"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_subflow_detail",
      "description": "读取测试流拓扑摘要与 flowOutputs，无需另传 graphJson；浏览子流结构优先于 get_flow",
      "parameters": {
        "type": "object",
        "properties": {
          "testFlowId": {
            "type": "string",
            "description": "被引用的测试流 id；可省略，将使用请求上下文中的 testFlowId"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_http_node",
      "description": "新增或修改单个HTTP节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。 【MCP 全自动】本工具成功后立即写入测试流库，无需再 commit。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "data": {
            "type": "object",
            "required": [
              "callMode"
            ],
            "properties": {
              "callMode": {
                "type": "string",
                "enum": [
                  "project",
                  "external"
                ]
              },
              "name": {
                "type": "string"
              },
              "testProjectApiId": {
                "type": "string"
              },
              "externalUrl": {
                "type": "string"
              },
              "httpMethod": {
                "type": "string"
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "requestBody": {
                "type": "string"
              },
              "requestValueOverrides": {
                "type": "object",
                "description": "节点测值覆盖（两桶）。query/path/header/表单用 paramDefaults；JSON body 用 bodyExample。值可为字面量或 {{flow.*}}。勿把参数名写在顶层。",
                "properties": {
                  "paramDefaults": {
                    "type": "object",
                    "description": "按参数名覆盖 query/path/header/form-data/urlencoded 的 value"
                  },
                  "bodyExample": {
                    "description": "覆盖 JSON body 测值（对象或可解析 JSON 字符串）"
                  }
                }
              },
              "extracts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "expr"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "写入变量名，如 token"
                    },
                    "expr": {
                      "type": "string",
                      "description": "from=body 时须 $ 开头 JsonPath；from=setCookie 时为 Cookie 名"
                    },
                    "from": {
                      "type": "string",
                      "enum": [
                        "body",
                        "header",
                        "setCookie"
                      ]
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "flow",
                        "asset"
                      ]
                    }
                  }
                }
              },
              "successCheck": {
                "type": "object",
                "description": "业务码校验。mode=inherit|off；可选 successValues 非空整数数组（如 [1]）覆盖项目/接口约定。",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "inherit",
                      "off"
                    ],
                    "description": "inherit 校验业务码；off 关闭"
                  },
                  "successValues": {
                    "type": "array",
                    "description": "可选；非空时优先于项目约定与接口 biz_code_config",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              },
              "timeoutMs": {
                "type": "number"
              },
              "preScript": {
                "type": "string"
              },
              "postScript": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "data"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_assert_node",
      "description": "新增或修改单个断言节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。 【MCP 全自动】本工具成功后立即写入测试流库，无需再 commit。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "data": {
            "type": "object",
            "required": [
              "rules"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "left",
                    "operator"
                  ],
                  "properties": {
                    "left": {
                      "type": "string",
                      "description": "断言左值，如 http.body.code / flow.orderId / http.status"
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "contains",
                        "not_contains",
                        "exists"
                      ]
                    },
                    "right": {
                      "description": "比较右值；operator=exists 时可省略"
                    }
                  }
                },
                "minItems": 1
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "data"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_condition_node",
      "description": "新增或修改单个条件分支节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。 【MCP 全自动】本工具成功后立即写入测试流库，无需再 commit。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
          "id": {
            "type": "string",
            "description": "节点 id；update 必填；add 可省略（短名或雪花）"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "data": {
            "type": "object",
            "required": [
              "branches"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "if",
                        "elif",
                        "else"
                      ]
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "left",
                          "operator"
                        ],
                        "properties": {
                          "left": {
                            "type": "string",
                            "description": "断言左值，如 http.body.code / flow.orderId / http.status"
                          },
                          "operator": {
                            "type": "string",
                            "enum": [
                              "eq",
                              "ne",
                              "gt",
                              "gte",
                              "lt",
                              "lte",
                              "contains",
                              "not_contains",
                              "exists"
                            ]
                          },
                          "right": {
                            "description": "比较右值；operator=exists 时可省略"
                          }
                        }
                      }
                    },
                    "terminal": {
                      "type": "boolean"
                    }
                  }
                },
                "minItems": 1
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "data"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_assign_node",
      "description": "新增或修改单个赋值节点（恰好 1 个 Staging 单元）。必填 op=add|update；update 须 id；校验失败按 errors 再调本工具修正。AI 不造 input 节点。 【MCP 全自动】本工具成功后立即写入测试流库，无需再 commit。",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "update"
            ],
            "description": "add=新增；update=修改已有（须带 id；数组字段交完整数组）"
          },
