// 库存档点插件说明书：只做断点打存档与读档；场景造数由 qualitest.sut-db-scenario-seed 负责。
{
  "id": "qualitest.sut-db-archive-point",
  "version": "0.1.0",
  "displayName": "被测库存档点",
  "remarks": "对被测 SQL/Redis 做即时打存档与读档；需被测机安装 sdap，项目挂载 bindAlias。场景造数见 sut-db-scenario-seed。",
  "capabilities": [
    { "name": "list", "effect": "read", "gate": "none" },
    { "name": "archive.create", "effect": "write", "gate": "none" },
    { "name": "archive.restore", "effect": "write", "gate": "destructive" },
    { "name": "archive.delete", "effect": "write", "gate": "none" }
  ],
  "isolation": ["ui-slot:flow.badge.db-archive-point"],
  "hooks": [
    { "name": "onCheckpoint", "order": 100, "actions": ["archive.create"] },
    { "name": "onRestore", "order": 100, "actions": ["archive.restore"] }
  ],
  "projectMount": {
    "fields": [
      { "name": "bindAlias", "required": true, "pattern": "^[a-z][a-z0-9-]{1,63}$" },
      { "name": "storeKeys", "required": false }
    ],
    "inject": [
      { "from": "bindAlias", "to": "db.bindAlias" },
      { "from": "storeKeys", "to": "storeKeys" }
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "db": {
        "type": "object",
        "properties": {
          "resolve": { "type": "string", "enum": ["bind-file", "explicit"] },
          "bindEnvKey": { "type": "string" },
          "storeKey": { "type": "string" }
        }
      },
      "storeRoot": { "type": ["string", "null"] },
      "defaultSaveId": { "type": "string" }
    }
  },
  "push": {
    "products": [
      { "productId": "sdap", "artifact": "agent/sdap", "artifactWin": "agent/sdap.exe" }
    ]
  },
  "ui": {
    "chrome": {
      "badges": [
        { "id": "db-archive-point", "text": "存档点", "tone": "info" }
      ]
    },
    "env": {
      "badge": { "text": "存档点", "tone": "warning" },
      "actions": [
        { "id": "list-saves", "label": "查看存档", "capability": "list" }
      ],
      "panel": {
        "entry": "ui/env-panel.js"
      }
    }
  },
  "runtime": {
    "kind": "ops-agent",
    "agent": {
      "bundle": "embedded",
      "cli": {
        "bin": "sdap",
        "pingArgs": ["ping"],
        "argMap": {
          "saveId": "--id",
          "storeKey": "--db"
        }
      }
    }
  }
}
