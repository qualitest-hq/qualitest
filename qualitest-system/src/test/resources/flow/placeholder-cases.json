{
  "mockContext": {
    "env": {
      "baseUrl": "https://dev.example.com",
      "timeout": 30
    },
    "flow": {
      "token": "abc",
      "loginUser": "admin"
    },
    "asset": {
      "defaults": {
        "apiKey": "sk-demo",
        "nested": {
          "x": 1
        }
      },
      "reporter_01": {
        "account": {
          "password": "secret"
        }
      }
    },
    "lastResponse": {
      "status": 200,
      "durationMs": 120,
      "headers": {
        "Authorization": "Bearer body-token"
      },
      "body": {
        "data": {
          "code": 0,
          "token": "body-token"
        }
      }
    }
  },
  "cases": [
    {
      "id": "env-base-url",
      "template": "{{env.baseUrl}}/api",
      "expected": "https://dev.example.com/api",
      "mode": "both"
    },
    {
      "id": "flow-token",
      "template": "{{flow.token}}",
      "expected": "abc",
      "mode": "both"
    },
    {
      "id": "asset-scalar",
      "template": "{{asset.defaults.apiKey}}",
      "expected": "sk-demo",
      "mode": "both"
    },
    {
      "id": "asset-nested",
      "template": "{{asset.defaults.nested.x}}",
      "expected": "1",
      "mode": "both"
    },
    {
      "id": "asset-deep",
      "template": "{{asset.reporter_01.account.password}}",
      "expected": "secret",
      "mode": "both"
    },
    {
      "id": "mixed-template",
      "template": "Bearer {{flow.token}}!",
      "expected": "Bearer abc!",
      "mode": "both"
    },
    {
      "id": "http-body-code",
      "template": "{{http.body.data.code}}",
      "expected": "0",
      "mode": "both"
    },
    {
      "id": "http-status",
      "template": "{{http.status}}",
      "expected": "200",
      "mode": "both"
    },
    {
      "id": "http-duration",
      "template": "{{http.duration}}",
      "expected": "120",
      "mode": "both"
    },
    {
      "id": "http-header",
      "template": "{{http.header.Authorization}}",
      "expected": "Bearer body-token",
      "mode": "both"
    },
    {
      "id": "null-template",
      "template": null,
      "expected": "",
      "mode": "both"
    },
    {
      "id": "missing-lenient",
      "template": "x{{flow.missing}}y",
      "expected": "xy",
      "mode": "lenient"
    },
    {
      "id": "missing-strict",
      "template": "{{flow.missing}}",
      "errorCode": "TF_PLACEHOLDER_UNDEFINED",
      "mode": "strict"
    },
    {
      "id": "missing-strict-partial",
      "template": "Bearer {{flow.missing}}",
      "errorCode": "TF_PLACEHOLDER_UNDEFINED",
      "mode": "strict"
    }
  ]
}
