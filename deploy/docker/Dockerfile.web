# 质衡前端构建 + Nginx
# 构建上下文：仓库根目录

FROM node:20-alpine AS build
WORKDIR /ui

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

# 先只拷清单文件，最大化利用 Docker 层缓存
COPY qualitest-ui/package.json qualitest-ui/pnpm-lock.yaml qualitest-ui/pnpm-workspace.yaml qualitest-ui/.npmrc ./
COPY qualitest-ui/apps/web/package.json ./apps/web/
COPY qualitest-ui/apps/desktop/package.json ./apps/desktop/
COPY qualitest-ui/packages/transport-types/package.json ./packages/transport-types/
RUN pnpm install --frozen-lockfile

COPY qualitest-ui/apps ./apps
COPY qualitest-ui/packages ./packages
RUN pnpm build:prod

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/apps/web/dist /usr/share/nginx/html

EXPOSE 80
