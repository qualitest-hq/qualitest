# 质衡前端构建 + Nginx
# 构建上下文：仓库根目录

FROM node:20-alpine AS build
WORKDIR /ui

# 仓库使用 Yarn classic（lockfile v1）
RUN apk add --no-cache yarn

COPY qualitest-ui/package.json qualitest-ui/yarn.lock ./
COPY qualitest-ui/apps ./apps
COPY qualitest-ui/packages ./packages

RUN yarn install --frozen-lockfile \
    && yarn build:prod

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/apps/web/dist /usr/share/nginx/html

EXPOSE 80
