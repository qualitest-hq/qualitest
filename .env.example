# Qualitest / 质衡 — 环境变量示例（复制为 .env 后按需填写；.env 勿提交）
# 对应 Spring profile：dev / prod / docker（见 qualitest-admin/.../application-*.yml）

# --- 服务 ---
SERVER_PORT=8080

# --- 上传目录 ---
# 本地 Windows 示例：D:/ruoyi/uploadPath
# Docker 固定：/data/upload
QUALITEST_PROFILE=D:/ruoyi/uploadPath

# --- MySQL ---
SPRING_DATASOURCE_DRUID_MASTER_URL=jdbc:mysql://localhost:3306/qualitest?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
SPRING_DATASOURCE_DRUID_MASTER_USERNAME=root
SPRING_DATASOURCE_DRUID_MASTER_PASSWORD=change-me

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=10
SPRING_DATA_REDIS_PASSWORD=

# --- JWT（生产 / Docker 必须使用强随机值）---
TOKEN_SECRET=change-me-to-a-long-random-string
TOKEN_EXPIRE_TIME=1440

# --- 日志 ---
LOGGING_LEVEL_COM_QUALITEST=info

# --- 仅开发环境 Druid 控制台（生产 / docker profile 已关闭）---
# DRUID_STAT_USERNAME=ruoyi
# DRUID_STAT_PASSWORD=change-me
