# 页面标题
VITE_APP_TITLE = 质衡

# 开发环境配置
VITE_APP_ENV = 'development'

# 质衡自动化测试系统/开发环境（Vite 代理前缀，非密钥）
VITE_APP_BASE_API = '/dev-api'

# 登录页预填（仅开发；正式生产勿填。公网演示用运维仓挂载 config.js）
# VITE_APP_LOGIN_USERNAME = admin
# VITE_APP_LOGIN_PASSWORD = admin123

# 可选：构建默认传输模式（页面切换优先于此项）
# VITE_QUALITEST_HTTP_TRANSPORT=browser
# Web 端 Java 转发同源路径（开发环境示例）
VITE_HTTP_FORWARD_API=/dev-api/test/http-forward
