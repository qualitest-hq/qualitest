{
  "name": "qualitest-ui",
  "private": true,
  "version": "3.9.1",
  "description": "质衡前端 workspace（Web + Electron）",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "wait-on": "8.0.1"
  },
  "scripts": {
    "dev": "yarn dev:web",
    "dev:web": "yarn workspace @qualitest/web dev",
    "build": "yarn build:web",
    "build:web": "yarn workspace @qualitest/web build:prod",
    "build:prod": "yarn build:web",
    "build:stage": "yarn workspace @qualitest/web build:stage",
    "preview": "yarn workspace @qualitest/web preview",
    "dev:desktop": "concurrently -k -n web,desk -c blue,magenta \"yarn dev:web\" \"node ./node_modules/wait-on/bin/wait-on http://127.0.0.1:5173 && yarn workspace @qualitest/desktop dev\"",
    "dev:desktop:only": "yarn workspace @qualitest/desktop dev",
    "build:desktop": "yarn workspace @qualitest/web build:desktop && yarn workspace @qualitest/desktop build"
  }
}
