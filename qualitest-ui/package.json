{
  "name": "qualitest-ui",
  "private": true,
  "version": "1.4.3",
  "description": "质衡前端 workspace（Web + Electron）",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "wait-on": "8.0.1"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter @qualitest/web dev",
    "build": "pnpm run build:web",
    "build:web": "pnpm --filter @qualitest/web build:prod",
    "build:prod": "pnpm run build:web",
    "build:stage": "pnpm --filter @qualitest/web build:stage",
    "preview": "pnpm --filter @qualitest/web preview",
    "test": "pnpm --filter @qualitest/web test",
    "test:watch": "pnpm --filter @qualitest/web test:watch",
    "test:flow": "pnpm --filter @qualitest/web test:flow",
    "test:project": "pnpm --filter @qualitest/web test:project",
    "test:ai": "pnpm --filter @qualitest/web test:ai",
    "test:utils": "pnpm --filter @qualitest/web test:utils",
    "dev:desktop": "concurrently -k -n web,desk -c blue,magenta \"pnpm run dev:web\" \"pnpm exec wait-on http://127.0.0.1:5180 && pnpm --filter @qualitest/desktop dev\"",
    "dev:desktop:only": "pnpm --filter @qualitest/desktop dev",
    "build:desktop": "pnpm --filter @qualitest/web build:desktop && pnpm --filter @qualitest/desktop build"
  }
}
