{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualitest.local/schemas/project-template.slim.v1.json",
  "title": "质衡项目模板精简包",
  "description": "冷启动用短 JSON：描述鉴权接口、素材、环境；不含预制测试流。",
  "type": "object",
  "required": ["templateName", "authStyle", "apis"],
  "additionalProperties": true,
  "properties": {
    "templateName": {
      "type": "string",
      "minLength": 1
    },
    "remark": { "type": "string" },
    "enableStatus": { "type": "integer", "enum": [0, 1] },
    "sortNum": { "type": "integer" },
    "authStyle": {
      "type": "string",
      "enum": ["bearer", "session", "header", "none", "custom"]
    },
    "pathPrefix": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "禁止单独 \"/\""
    },
    "credential": {
      "type": "object",
      "properties": {
        "asset": { "type": "string" },
        "extract": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "from": { "type": "string" },
                "expr": { "type": "string" }
              }
            }
          ]
        },
        "tokenField": { "type": "string" },
        "cookieName": { "type": "string" },
        "headerName": { "type": "string" },
        "headerValueTemplate": { "type": "string" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "env": {
      "type": "object",
      "properties": {
        "envName": { "type": "string" },
        "envUrl": { "type": "string" },
        "variables": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "envs": {
      "type": "array",
      "items": { "$ref": "#/properties/env" }
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "method", "path"],
        "properties": {
          "name": { "type": "string" },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "authMode": { "type": "string" },
          "apiGroup": { "type": "string" },
          "bodyMode": { "type": "string", "enum": ["json", "form", "none"] },
          "headers": { "type": "object", "additionalProperties": true },
          "query": { "type": "object", "additionalProperties": true },
          "body": { "type": "object", "additionalProperties": true },
          "response": { "type": "object", "additionalProperties": true },
          "syncProtected": { "type": ["boolean", "integer"] }
        },
        "additionalProperties": true
      }
    },
    "_uncertain": {
      "type": "array",
      "items": { "type": "string" }
    },
    "flows": {
      "description": "不接受；传入将被忽略并 warning",
      "type": "array"
    }
  }
}
