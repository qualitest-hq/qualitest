# Cursor 索引忽略配置

########################
# 版本控制与 IDE 相关
########################
.git/
.idea/
.vscode/
**/.classpath
**/.project
**/.settings/
**/*.iml

########################
# 构建输出 / 编译产物
########################
**/target/
**/out/
**/bin/
**/build/

########################
# 二进制 / 依赖包
########################
**/*.class
**/*.jar
**/*.war
**/*.ear

########################
# 日志 / 临时文件
########################
**/*.log
**/~$*
**/*.tmp

########################
# 前端
########################
**/node_modules/
**/dist/
**/.turbo/

########################
# 系统文件
########################
**/.DS_Store
**/Thumbs.db
