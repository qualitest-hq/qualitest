---
---

<footer class="foot">
  <div class="wrap foot-inner">
    <p class="brand-line">
      <span class="mark" aria-hidden="true"></span>
      <strong>质衡 Qualitest</strong>
      <span class="sep">·</span>
      Apache License 2.0
      <span class="sep">·</span>
      <a href="https://github.com/qualitest-hq">qualitest-hq</a>
    </p>
    <p class="links">
      <a href="https://github.com/qualitest-hq/qualitest/blob/main/README.md">中文 README</a>
      <span class="sep">·</span>
      <a href="https://github.com/qualitest-hq/qualitest/blob/main/README.en.md">English README</a>
      <span class="sep">·</span>
      <a href="https://github.com/qualitest-hq/qualitest/blob/main/SECURITY.md">Security</a>
    </p>
  </div>
</footer>

<style>
  .foot {
    padding: 2.75rem 0 3.25rem;
    border-top: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.25);
  }

  .foot-inner {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .brand-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }

  .mark {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: linear-gradient(145deg, var(--accent-bright), var(--accent-deep));
  }

  strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 650;
  }

  .sep {
    opacity: 0.45;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
