---
import { type Lang, useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const clips = [
  {
    title: t.mcpSurveyTitle,
    desc: t.mcpSurveyDesc,
    steps: t.mcpSurveySteps,
  },
  {
    title: t.mcpAutoWriteTitle,
    desc: t.mcpAutoWriteDesc,
    steps: t.mcpAutoWriteSteps,
  },
] as const;
---

<section class="section mcp" id="mcp">
  <div class="wrap">
    <h2 class="section-title">{t.mcpTitle}</h2>
    <p class="section-lead">
      {t.mcpLead}
      {" "}
      <a href={t.mcpDocsHref}>{t.mcpDocsLabel}</a>
      {t.mcpLeadAfter}
    </p>

    <ul class="clips">
      {
        clips.map((clip) => (
          <li class="clip">
            <div class="card">
              <h3>{clip.title}</h3>
              <p class="desc">{clip.desc}</p>
              <ol>
                {clip.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .mcp {
    border-block: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.18));
  }

  .clips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .clips {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card {
    height: 100%;
    padding: 1.35rem 1.4rem 1.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse 70% 60% at 30% 20%, rgba(20, 184, 166, 0.1), transparent 55%),
      linear-gradient(165deg, #f7faf9, #eef3f4);
    box-shadow: var(--shadow-soft);
  }

  .card h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .desc {
    margin: 0 0 0.85rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .card ol {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .card li + li {
    margin-top: 0.35rem;
  }
</style>
