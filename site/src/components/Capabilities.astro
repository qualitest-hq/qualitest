---
import { type Lang, useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section capabilities">
  <div class="wrap">
    <h2 class="section-title">{t.capTitle}</h2>
    <p class="section-lead">{t.capLead}</p>

    <ol class="rail">
      {
        t.capSteps.map((step, i) => (
          <li>
            <span class="idx">{String(i + 1).padStart(2, "0")}</span>
            <strong>{step.title}</strong>
            <p>{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .capabilities {
    position: relative;
    border-block: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.28));
  }

  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem 1.35rem;
  }

  @media (min-width: 900px) {
    .rail {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.1rem;
      position: relative;
    }

    .rail::before {
      content: "";
      position: absolute;
      top: 0.95rem;
      left: 6%;
      right: 6%;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(20, 184, 166, 0.15),
        rgba(15, 118, 110, 0.55),
        rgba(20, 184, 166, 0.15),
        transparent
      );
      pointer-events: none;
    }
  }

  .rail li {
    position: relative;
    margin: 0;
    padding: 0.15rem 0 0;
  }

  .idx {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.85rem;
    height: 1.85rem;
    margin-bottom: 0.85rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--surface-strong);
    border: 1px solid rgba(15, 118, 110, 0.25);
    box-shadow: 0 0 0 4px var(--accent-soft);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
  }

  strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 650;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.55;
  }
</style>
