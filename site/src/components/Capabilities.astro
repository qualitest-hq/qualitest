---
import fs from "node:fs";
import path from "node:path";
import { type Lang, useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const imagesDir = path.join(process.cwd(), "public", "images");

const demos = [
  {
    file: "debug-200.gif",
    title: t.capDemoDebugTitle,
    alt: t.capDemoDebugAlt,
  },
  {
    file: "canvas-glance.gif",
    title: t.capDemoCanvasTitle,
    alt: t.capDemoCanvasAlt,
  },
].filter((d) => fs.existsSync(path.join(imagesDir, d.file)));
---

<section class="section capabilities">
  <div class="wrap">
    <h2 class="section-title">{t.capTitle}</h2>
    <p class="section-lead">{t.capLead}</p>

    <ol class="rail">
      {
        t.capSteps.map((step, i) => (
          <li>
            <span class="idx">{String(i + 1).padStart(2, "0")}</span>
            <strong>{step.title}</strong>
            <p>{step.desc}</p>
          </li>
        ))
      }
    </ol>

    {
      demos.length > 0 && (
        <ul class="demos">
          {demos.map((demo) => (
            <li>
              <figure>
                <figcaption>{demo.title}</figcaption>
                <img
                  src={`${base}images/${demo.file}`}
                  alt={demo.alt}
                  width="960"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .capabilities {
    position: relative;
    border-block: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.28));
  }

  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem 1.35rem;
  }

  @media (min-width: 900px) {
    .rail {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.1rem;
      position: relative;
    }

    .rail::before {
      content: "";
      position: absolute;
      top: 0.95rem;
      left: 6%;
      right: 6%;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(20, 184, 166, 0.15),
        rgba(15, 118, 110, 0.55),
        rgba(20, 184, 166, 0.15),
        transparent
      );
      pointer-events: none;
    }
  }

  .rail li {
    position: relative;
    margin: 0;
    padding: 0.15rem 0 0;
  }

  .idx {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.85rem;
    height: 1.85rem;
    margin-bottom: 0.85rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--surface-strong);
    border: 1px solid rgba(15, 118, 110, 0.25);
    box-shadow: 0 0 0 4px var(--accent-soft);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
  }

  .rail strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 650;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .rail p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .demos {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 860px) {
    .demos {
      grid-template-columns: 1fr 1fr;
    }
  }

  .demos figure {
    margin: 0;
    padding: 0.85rem 0.9rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse 70% 60% at 30% 20%, rgba(20, 184, 166, 0.1), transparent 55%),
      linear-gradient(165deg, #f7faf9, #eef3f4);
    box-shadow: var(--shadow-soft);
  }

  .demos figcaption {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .demos img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 4px);
    border: 1px solid rgba(12, 18, 34, 0.06);
    background: #fff;
  }
</style>
