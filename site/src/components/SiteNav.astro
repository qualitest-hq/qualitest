---
import { type Lang, pathForLang, useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const home = pathForLang(lang, base);
const zhHref = pathForLang("zh", base);
const enHref = pathForLang("en", base);
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={home}>
      <span class="mark" aria-hidden="true"></span>
      {t.navBrand}
    </a>
    <nav class="links" aria-label={t.navAria}>
      <a href={t.docsHref}>{t.navDocs}</a>
      <a href="https://github.com/qualitest-hq/qualitest-demo">{t.navDemo}</a>
      <a href="https://github.com/qualitest-hq/qualitest-intellij-plugin">{t.navPlugin}</a>
      <a class="gh" href="https://github.com/qualitest-hq/qualitest">{t.navGitHub}</a>
      <span class="lang" role="group" aria-label={t.langSwitchAria}>
        <a class:list={[{ active: lang === "zh" }]} href={zhHref} hreflang="zh-CN" lang="zh-CN">中文</a>
        <a class:list={[{ active: lang === "en" }]} href={enHref} hreflang="en" lang="en">EN</a>
      </span>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px) saturate(1.2);
    background: rgba(241, 245, 244, 0.72);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.18rem;
    letter-spacing: 0.06em;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 2px;
    background: linear-gradient(145deg, var(--accent-bright), var(--accent-deep));
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .brand:hover {
    color: var(--accent-deep);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.15rem;
    font-size: 0.94rem;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 550;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .links a:hover {
    color: var(--accent-deep);
    background: var(--accent-soft);
  }

  .links .gh {
    margin-left: 0.25rem;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.5);
    color: var(--ink);
  }

  .links .gh:hover {
    border-color: rgba(15, 118, 110, 0.35);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    margin-left: 0.35rem;
    padding: 0.12rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.45);
  }

  .lang a {
    padding: 0.28rem 0.55rem;
    font-size: 0.8rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .lang a.active {
    color: var(--accent-deep);
    background: var(--accent-soft);
  }
</style>
